{
  "name": "job-hunt-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Personal MCP server + local dashboard for finding EU-eligible remote jobs and tracking applications.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mcp": "tsx src/index.ts",
    "dashboard": "tsx src/dashboard.ts",
    "sanity": "tsx src/eligibility.ts",
    "setup:jobspy": "python -m venv .venv && .venv/Scripts/python.exe -m pip install -q -U python-jobspy",
    "setup:jobspy:unix": "python3 -m venv .venv && .venv/bin/python -m pip install -q -U python-jobspy",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run sanity && npm run test:ranking && npm run test:mcp && npm run test:ui",
    "test:ranking": "node --import tsx tests/ranking.mjs",
    "test:mcp": "node tests/mcp.mjs",
    "test:ui": "node tests/ui.mjs"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@picocss/pico": "^2.1.1",
    "better-sqlite3": "^12.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
