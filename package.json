{
  "name": "job-hunt-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Personal MCP server + local dashboard for finding EU-eligible remote jobs and tracking applications.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "mcp": "tsx src/index.ts",
    "dashboard": "tsx src/dashboard.ts",
    "refresh": "tsx src/refresh.ts",
    "sanity": "tsx src/eligibility.ts",
    "setup:jobspy": "python -m venv .venv && .venv/Scripts/python.exe -m pip install -q python-jobspy==1.1.82",
    "setup:jobspy:unix": "python3 -m venv .venv && .venv/bin/python -m pip install -q python-jobspy==1.1.82",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run sanity && npm run test:ranking && npm run test:boards && npm run test:verdict && npm run test:mcp && npm run test:ui",
    "test:ranking": "node --import tsx tests/ranking.mjs",
    "test:verdict": "node --import tsx tests/verdict.mjs",
    "test:boards": "node --import tsx tests/boards.mjs",
    "test:mcp": "node tests/mcp.mjs",
    "test:ui": "node tests/ui.mjs",
    "eval:verdicts": "tsx scripts/verdict-eval.ts"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^12.2.0",
    "unpdf": "^1.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "playwright": "^1.64.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
